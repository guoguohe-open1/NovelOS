# Public local-development values only. Never add provider credentials here.
# API and optional Compose commands explicitly select this file; existing .env is unused.
# DB_* values configure optional Compose. Native PostgreSQL uses the same local values.
NOVELOS_ENVIRONMENT=development
NOVELOS_DB_USER=novelos
NOVELOS_DB_PASSWORD=novelos_local_only
NOVELOS_DB_NAME=novelos
NOVELOS_DB_PORT=5432
NOVELOS_DATABASE_URL=postgresql+psycopg://novelos:novelos_local_only@127.0.0.1:5432/novelos
NOVELOS_CORS_ORIGINS='["http://127.0.0.1:3000","http://localhost:3000"]'
